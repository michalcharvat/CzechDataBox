{
  "name": "michalcharvat/czech-data-box",
  "type": "library",
  "description": "Client for the Czech data box information system (ISDS) web services, WSDL 3.10.",
  "keywords": ["ISDS", "datové schránky", "datovka", "ZFO"],
  "license": "MIT",
  "authors": [
    {"name": "Michal Charvát", "email": "info@michalcharvat.cz"},
    {"name": "Dennis Fridrich", "email": "fridrich.dennis@gmail.com"}
  ],
  "require": {
    "php": ">=8.1",
    "ext-soap": "*",
    "ext-openssl": "*",
    "ext-curl": "*",
    "ext-xml": "*",
    "ext-dom": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5",
    "phpstan/phpstan": "^1.11"
  },
  "autoload": {"psr-4": {"MichalCharvat\\CzechDataBox\\": "src/"}},
  "autoload-dev": {"psr-4": {"MichalCharvat\\CzechDataBox\\Tests\\": "tests/"}},
  "scripts": {
    "test": "phpunit --testsuite unit",
    "test-live": "phpunit --testsuite live",
    "analyse": "@php -d memory_limit=1G vendor/bin/phpstan analyse"
  },
  "config": {"sort-packages": true}
}
